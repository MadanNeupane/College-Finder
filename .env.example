# =============================================================================
# College Finder — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# This file is safe to commit — it contains NO real secrets.
# =============================================================================

# --- Core -------------------------------------------------------------------
SECRET_KEY = your-secret-key-here-generate-with-django-get-random-secret-key
DEBUG = True

# --- Allowed Hosts ----------------------------------------------------------
# Comma-separated. Add your deployment domain here for production.
ALLOWED_HOSTS = localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# SQLite (default — leave DATABASE_URL blank or remove it):
# DATABASE_URL =

# PostgreSQL example:
# DATABASE_URL = postgresql://user:password@hostname:5432/dbname

# Extra DB connection options (used only when DATABASE_URL is set)
# DB_CONN_MAX_AGE = 600       # seconds; 0 = close after each request
# DB_SSL_REQUIRE = False      # set True for Render/Railway/Heroku Postgres

# --- Static Files -----------------------------------------------------------
# Controls which WhiteNoise storage backend is used.
# True  → compressed, cache-busted files (production recommended)
# False → plain files, no hashing (faster local dev)
USE_WHITENOISE_MANIFEST = False

# --- Media Files ------------------------------------------------------------
# True  → Django serves /media/ directly (fine for low-traffic hobby sites)
# False → serve MEDIA_ROOT via nginx / CDN (for higher traffic)
SERVE_MEDIA_IN_PRODUCTION = True

# --- Email ------------------------------------------------------------------
# Remove or comment out all EMAIL_* vars to use the console email backend.
EMAIL_BACKEND = django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST = smtp.gmail.com
EMAIL_HOST_USER = your-email@gmail.com
DEFAULT_FROM_EMAIL = College Finder <your-email@gmail.com>
EMAIL_HOST_PASSWORD = your-app-password
EMAIL_USE_TLS = True
EMAIL_PORT = 587

# --- Social Auth ------------------------------------------------------------
SOCIAL_AUTH_FACEBOOK_KEY = your-facebook-app-id
SOCIAL_AUTH_FACEBOOK_SECRET = your-facebook-app-secret
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY = your-google-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET = your-google-client-secret

# --- Security (production) --------------------------------------------------
# Uncomment and set these when deploying to production.
# CSRF_TRUSTED_ORIGINS = https://your-app.onrender.com
# SECURE_SSL_REDIRECT = True
# SECURE_HSTS_SECONDS = 31536000

# --- Admin Superuser --------------------------------------------------------
DJANGO_SUPERUSER_USERNAME = admin
DJANGO_SUPERUSER_EMAIL = admin@example.com
DJANGO_SUPERUSER_PASSWORD = ChangeMe@2025!

# --- Admin Contact ----------------------------------------------------------
ADMIN_EMAIL = admin@example.com

# --- Monitoring (optional) --------------------------------------------------
# SENTRY_DSN = https://xxxx@o000000.ingest.sentry.io/0000000
